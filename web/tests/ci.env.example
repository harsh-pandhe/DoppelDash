# Environment NAMES used by the backend test run (web/scripts/ci/run-backend-tests.js). NO values are stored here.
# Every secret is generated fresh at run time (random, throw-away) and never leaves the runner; providers are local fakes.
# Anything set in the environment before the run wins over the generated default.

# Database — must be a throw-away LOOPBACK MongoDB (the harness refuses anything else). The database name is generated per run.
MONGODB_URI
# Server under test
TEST_URL
NEXT_PUBLIC_APP_URL
# Secrets (generated at run time)
JWT_SECRET
ENCRYPTION_SECRET
CRON_SECRET
DEV_SEED_SECRET
SETUP_SECRET
ALLOW_DEV_SEED
# Outbound mail -> local fake SMTP started by the tests
SMTP_HOST
SMTP_PORT
SMTP_SECURE
SMTP_USER
SMTP_PASS
SMTP_FROM
# Auth timing used by tests
REFRESH_REUSE_GRACE_MS
# Local fake providers (tests/helpers/fakeProviders.js)
CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET
CLOUDINARY_UPLOAD_BASE
CLOUDINARY_DELIVERY_BASE
GEMINI_API_KEY
GEMINI_API_BASE
OLLAMA_URL
FAKE_PROVIDERS_PORT
# Behaviour switches for tests (never set in production)
RECEIPT_CLEANUP_APPLY
OCR_DEADLINE_MS
TRAVEL_FAILPOINTS
TRAVEL_CONVERSION_WAIT_MS
# Server log captured for the final secret scan
DD_SERVER_LOG
# Separate build directory for the spawned dev server
NEXT_DIST_DIR
