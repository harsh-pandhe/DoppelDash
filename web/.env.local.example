# DoppelDash environment configuration.
# Copy to .env.local for local dev; set the same keys in the Netlify UI for prod.
# Every value below is read by the app — nothing here is decorative.

# ─── Required: app fails closed without these ────────────────────────────────

MONGODB_URI=mongodb://localhost:27017/doppeldash

# Signs session cookies AND peppers stored OTP hashes. Generate with:
#   openssl rand -base64 32
# Throws at runtime in production if unset — no insecure fallback exists.
JWT_SECRET=

# Encrypts CRM contact PII and TOTP secrets at rest. Generate the same way.
# Rotating this makes existing encrypted rows unreadable.
ENCRYPTION_SECRET=

# Public origin, no trailing slash. Passkeys derive their rpID/origin from this —
# if it does not exactly match the browser's address bar, WebAuthn login fails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Outbound email (login OTPs, approval notifications, announcements) ──────

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=DoppelDash <no-reply@doppelmayr.in>

# ─── Inbox sync (IMAP poll-on-demand) ────────────────────────────────────────
# IMAP_PASS must be a Gmail *app password*, not the account password.

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=

# ─── File uploads (Cloudinary, unsigned direct-from-browser) ─────────────────
# Create the preset under Settings → Upload → Upload presets with
# Signing Mode: Unsigned. Never put the Cloudinary API secret here — anything
# prefixed NEXT_PUBLIC_ is compiled into the client bundle and publicly visible.

NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# SIGNED uploads (REQUIRED in production): server-only secrets — never NEXT_PUBLIC_, never sent to a client. Uploads are
# authenticated, tenant-foldered and server-constrained; without BOTH the server refuses to issue upload tickets (fail closed).
# See docs/RECEIPT_STORAGE_AND_OCR.md.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional SIGNED upload preset (provider-side enforcement of formats / size / delivery type)
CLOUDINARY_SIGNED_PRESET=
# LOCAL DEVELOPMENT ONLY (ignored when NODE_ENV=production): legacy unsigned uploads need BOTH an unsigned preset and the flag.
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# ALLOW_UNSIGNED_UPLOADS=1

# ─── AI (business-card / receipt OCR, sign-in support chat) ──────────────────

GEMINI_API_KEY=

# Local Ollama fallback for OCR. Unreachable from Netlify — dev only.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Netlify does not run the crons declared in vercel.json. Trigger these from an
# external scheduler with the header  Authorization: Bearer <CRON_SECRET>
# (the secret is NOT accepted in the URL — query strings end up in access logs):
#   /api/cron/announcements   */5 * * * *
#   /api/cron/birthday        0 8 * * *
#   /api/cron/onboarding      0 9 * * *

CRON_SECRET=

# ─── One-time / maintenance secrets ──────────────────────────────────────────

# Gates /api/auth/setup (creates the first admin). Endpoint returns 503 if unset.
SETUP_SECRET=

# Gates /api/dev/seed, /api/dev/migrate and /api/dev/reset-to-admin.
# Both must be set for those routes to run. Leave ALLOW_DEV_SEED false in
# production except for the brief window you are running a reset —
# reset-to-admin permanently deletes all non-admin data.
DEV_SEED_SECRET=
ALLOW_DEV_SEED=false

# ─── Optional: Microsoft Outlook integration ─────────────────────────────────

OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# Webhook auth for /api/webhooks/outlook. Notifications are ignored if unset.
OUTLOOK_WEBHOOK_SECRET=

# Abandoned-receipt cleanup: deletion needs BOTH "mode":"apply" in the POST body of the cron call and RECEIPT_CLEANUP_APPLY=1 here (default: dry-run only)
# RECEIPT_CLEANUP_APPLY=1
